":"","firstPage":16,"confidence":1,"bookKey":"g4s1"},{"id":"G4S1_E00098","name":"越过高山，越过平原，跨过奔腾的黄河长江，宽广美丽的土地，是我们亲爱的家乡。英雄的人民站起来了！我们团结友爱坚强如钢。我们勤劳，我们勇敢，独立自由是我们的理想，我们战胜了多少苦难，才得到今天的解放！我们爱和平，我们爱家乡，谁敢侵犯我们就叫他灭亡！东方太阳，正在升起，人民共和国正在成长，我们领袖毛泽东，指引着前进的方向。我们的生活天天向上，我们的前途万丈光芒。","type":"歌词","aliases":[],"description":"","firstPage":17,"confidence":1,"bookKey":"g4s1"},{"id":"G4S1_E00099","name":"标出歌曲中的弱起小节","type":"学习活动","aliases":[],"description":"","firstPage":17,"confidence":1,"bookKey":"g4s1"},{"id":"G4S1_E00100","name":"江苏","type":"地域","aliases":[],"description":"","firstPage":18,"confidence":1,"bookKey":"g4s1"},{"id":"G4S1_E00101","name":"伴奏节奏谱","type":"音乐概念","aliases":[],"description":"","firstPage":18,"confidence":1,"bookKey":"g4s1"},{"id":"G4S1_E00102","name":"《江苏民歌《杨柳青》》","type":"民歌","aliases":[],"description":"","firstPage":20,"confidence":1,"bookKey":"g4s1"},{"id":"G4S1_E00103","name":"朱昌耀","type":"人物","aliases":[],"description":"","firstPage":20,"confidence":1,"bookKey":"g4s1"},{"id":"G4S1_E00104","name":"王爱康","type":"人物","aliases":[],"description":"","firstPage":20,"confidence":1,"bookKey":"g4s1"},{"id":"G4S1_E00105","name":"民乐合奏","type":"表演形式","aliases":[],"description":"","firstPage":20,"confidence":1,"bookKey":"g4s1"},{"id":"G4S1_E00106","name":"1=D","type":"调性","aliases":[],"description":"","firstPage":20,"confidence":1,"bookKey":"g4s1"},{"id":"G4S1_E00107","name":"云南","type":"地域","aliases":[],"description":"","firstPage":21,"confidence":1,"bookKey":"g4s1"},{"id":"G4S1_E00108","name":"台湾","type":"地域","aliases":[],"description":"","firstPage":22,"confidence":1,"bookKey":"g4s1"},{"id":"G4S1_E00109","name":"《台湾民谣》","type":"民歌","aliases":[],"description":"","firstPage":22,"confidence":1,"bookKey":"g4s1"},{"id":"G4S1_E00110","name":"四川","type":"地域","aliases":[],"description":"","firstPage":24,"confidence":1,"bookKey":"g4s1"},{"id":"G4S1_E00111","name":"中速稍快","type":"速度术语","aliases":[],"description":"","firstPage":24,"confidence":1,"bookKey":"g4s1"},{"id":"G4S1_E00112","na